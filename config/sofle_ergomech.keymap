/*
 * FIXED VERSION - Sofle ZMK config
 */

#define ZMK_POINTING_DEFAULT_SCRL_VAL 300

#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        label = "LEFT_ENCODER";
        a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <60>;
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <30>;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5        &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp DEL
&kp TAB &kp Q  &kp W  &kp E  &kp R  &kp T         &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
&kp CAPS &kp A &kp S  &kp D  &kp F  &kp G         &kp H  &kp J  &kp K  &kp L  &kp SEMICOLON &kp SINGLE_QUOTE
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp K_MUTE &studio_unlock  &kp N &kp M &kp COMMA &kp PERIOD &kp FSLH &kp RSHFT
          &kp LGUI &kp LALT &kp LCTRL &mo 1 &kp ENTER &kp SPACE &mo 2 &kp RCTRL &kp RALT &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp &kp C_VOL_UP &kp C_VOL_DN>;
        };

        lower_layer {
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS &kp KP_PLUS &trans
&trans &kp PSCRN &kp INS &kp UP &kp AT &kp PRCNT   &kp N7 &kp N8 &kp N9 &kp KP_PLUS &trans &trans
&trans &trans &kp LEFT &kp DOWN &kp RIGHT &kp DLLR &kp N4 &kp N5 &kp N6 &kp KP_PLUS &trans &trans
&trans &trans &trans &kp C_PREV &kp C_NEXT &kp HASH &kp C_PLAY_PAUSE &trans &kp N1 &kp N2 &kp N3 &kp KP_ENTER &trans
            >;
        };

        raise_layer {
            bindings = <
&kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6      &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
&trans &kp GRAVE &kp TILDE &kp LT &kp GT &kp QMARK   &kp ASTRK &kp LBRC &kp RBRC &kp HOME &kp END &trans
&trans &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp UNDER &kp LPAR &kp RPAR &kp SEMICOLON &kp PIPE &trans
&trans &kp EQUAL &kp MINUS &kp PLUS &kp AMPS &kp PIPE &trans &trans &kp CARET &kp LBKT &kp RBKT &kp COLON &kp BSLH &trans
            >;
        };
    };
};
