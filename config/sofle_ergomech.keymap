#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {

        inc_dec_kp: inc_dec_kp {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_KEY";
            #sensor-binding-cells = <2>;
        };

        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            label = "RGB_ENCODER";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_HUI>, <&rgb_ug RGB_HUD>;
        };

        tab_browser: tab_browser {
            compatible = "zmk,behavior-sensor-rotate";
            label = "TAB_BROWSER";
            #sensor-binding-cells = <0>;
            bindings = <&kp LCTRL &kp TAB>, <&kp LCTRL &kp LSHFT &kp TAB>;
        };
    };

keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q   &kp W   &kp E   &kp R   &kp T        &kp Y   &kp U   &kp I   &kp O   &kp P
                &kp A   &kp S   &kp D   &kp F   &kp G        &kp H   &kp J   &kp K   &kp L   &kp SEMI
                &kp Z   &kp X   &kp C   &kp V   &kp B        &kp N   &kp M   &kp COMMA &kp DOT &kp SLASH
                                &mo 1  &kp SPACE &kp ENTER   &kp BSPC &mo 2
            >;
        };

        lower_layer {
            bindings = <
                &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT     &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR
                &kp 1    &kp 2    &kp 3    &kp 4    &kp 5         &kp 6     &kp 7    &kp 8    &kp 9    &kp 0
                &kp GRAVE &kp TILDE &kp LBKT &kp RBKT &kp PIPE    &kp MINUS &kp EQUAL &kp UNDERSCORE &kp PLUS &kp BACKSLASH
                                &trans &trans &trans     &trans &trans
            >;
        };

        raise_layer {
            bindings = <
                &kp ESC  &kp F1 &kp F2 &kp F3 &kp F4        &kp F5 &kp F6 &kp F7 &kp F8 &kp F9
                &kp TAB  &kp F10 &kp F11 &kp F12 &kp INS    &kp HOME &kp PG_DN &kp PG_UP &kp END &kp DEL
                &kp CAPS &kp LCTRL &kp LALT &kp LGUI &kp LSFT   &kp RSFT &kp LEFT &kp DOWN &kp UP &kp RIGHT
                                &trans &trans &trans      &trans &trans
            >;
        };
    };

