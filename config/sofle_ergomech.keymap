            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LSHFT &kp LALT>, <&macro_tap &kp DOWN>, <&macro_release &kp LSHFT &kp LALT>;
        };
        // VSCode: Fold all (Ctrl+K Ctrl+0)
        fold_all: fold_all {
            label = "FOLD_ALL";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
