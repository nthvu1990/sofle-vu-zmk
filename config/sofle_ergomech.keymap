            #binding-cells = <0>;
            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_PLUS &kp KP_N0 &kp KP_N0 &kp E &kp KP_N1>, <&macro_release &kp LALT>;
        };
        lfada_a: lfada_a {
            label = "LARGE_FADA_A";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
