            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_PLUS &kp KP_N0 &kp KP_N0 &kp C &kp KP_N4>, <&macro_release &kp LALT>;
