            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_PLUS &kp KP_N0 &kp KP_N0 &kp E &kp KP_N6>, <&macro_release &kp LALT>;
