        // VSCode: Rename Symbol (F2)
        rename_sym: rename_sym {
            label = "RENAME_SYMBOL";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_tap &kp F2>;
