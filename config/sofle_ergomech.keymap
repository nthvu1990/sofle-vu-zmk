/*
 * Copyright (c) 2020 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 *
 * Sofle VU ZMK — Revised Keymap
 * Layer 0: Default (QWERTY) — unchanged
 * Layer 1: Office  — Nav left / Numpad right
 * Layer 2: Code    — Symbols / F-keys / shortcuts
 * Layer 3: System  — Bluetooth + RGB
 *
 * Bugs fixed from original:
 *   - lower_layer numpad used kp N7-N3 instead of KP_N7-KP_N3 (no numlock-aware)
 *     → kept as kp Nx for Windows compatibility (numpad layer), added KP_DOT
 *   - lower_layer thumb row had 4×kp N0 for 0 key (redundant)
 *   - lower_layer RHS had duplicate kp KP_PLUS on rows 2 & 3
 *   - raise_layer had kp KP_PLUS on bottom row (should be kp PLUS for symbol layer)
 *   - teams_mute macro switches BT profile before sending shortcut (side-effect) — preserved but noted
 *   - gaeilge_layer had &fada_i (not tap-dance) on I position; should be td_sp_i — added td_sp_i tap dance
 *   - combo_less_equal / combo_gtr_equal reference layer 2 (raise), key positions 15,16,25,14 with LSHIFT(37)
 *     These are valid combo positions; preserved.
 *   - rgb_dec mod-morph only catches LSFT|RSFT (missing LCTL|RCTL like rgb_inc) — fixed
 *   - Encoder: lower_layer right encoder was PG_UP/PG_DN; raise_layer left was rgb_encoder — kept logical
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

//Encoder Support
//Alps Alpine EC11N1524402: 30 Detent, 15PPR, 2 Channel, Quadrature, 15000 Cycle
/ {
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        label = "LEFT_ENCODER";
        a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <60>;
    };
    right_encoder: encoder_right {
        compatible = "alps,ec11";
        label = "RIGHT_ENCODER";
        a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <60>;
    };
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <30>;
    };
};

/ {
    macros {
// ── System & Power ────────────────────────────────────────────────
        tm: tm {
            label = "TASK_MANAGER";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp ESC>
                , <&macro_release &kp LCTRL &kp LSHFT>
                ;
        };
        cad: cad {
            label = "CTRL_ALT_DEL";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT &kp DEL>
                , <&macro_release &kp LCTRL &kp LALT &kp DEL>
                ;
        };
        slp: slp {
            label = "SLEEP";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp X>
                , <&macro_release &kp LGUI>
                , <&macro_tap &kp U &kp S>
                ;
        };
        rst: rst {
            label = "RESTART";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp X>
                , <&macro_release &kp LGUI>
                , <&macro_tap &kp U &kp R>
                ;
        };
        off: off {
            label = "SHUTDOWN";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp X>
                , <&macro_release &kp LGUI>
                , <&macro_tap &kp U &kp U>
                ;
        };

// ── Office shortcuts ──────────────────────────────────────────────
        // Teams mute: NOTE — macro switches to BT profile 1 first.
        // Preserved from original; remove bt BT_SEL 1 if not needed.
        teams_mute: teams_mute {
            label = "TEAMS_MUTE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_tap   &bt BT_SEL 1>
                , <&macro_wait_time 100>
                , <&macro_press   &kp LGUI>
                , <&macro_tap     &kp N3>
                , <&macro_release &kp LGUI>
                , <&macro_wait_time 50>
                , <&macro_press   &kp LCTRL &kp LSHFT>
                , <&macro_tap     &kp M>
                , <&macro_release &kp LCTRL &kp LSHFT>
                ;
        };
        // Excel / Word shortcuts
        bold: bold {
            label = "BOLD";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp B>, <&macro_release &kp LCTRL>;
        };
        italic: italic {
            label = "ITALIC";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp I>, <&macro_release &kp LCTRL>;
        };
        underline: underline {
            label = "UNDERLINE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp U>, <&macro_release &kp LCTRL>;
        };
        save_file: save_file {
            label = "SAVE_FILE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>;
        };
        find_rep: find_rep {
            label = "FIND_REPLACE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp H>, <&macro_release &kp LCTRL>;
        };
        sel_all: sel_all {
            label = "SELECT_ALL";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp A>, <&macro_release &kp LCTRL>;
        };
        undo_act: undo_act {
            label = "UNDO";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp Z>, <&macro_release &kp LCTRL>;
        };
        redo_act: redo_act {
            label = "REDO";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp Y>, <&macro_release &kp LCTRL>;
        };
        // Excel: select to end of column (Ctrl+Shift+End)
        xl_sel_end: xl_sel_end {
            label = "XL_SELECT_TO_END";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LCTRL &kp LSHFT>, <&macro_tap &kp END>, <&macro_release &kp LCTRL &kp LSHFT>;
        };
        // Excel: AutoSum (Alt+=)
        xl_sum: xl_sum {
            label = "XL_AUTOSUM";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp EQUAL>, <&macro_release &kp LALT>;
        };

// ── Browser & Window controls ─────────────────────────────────────
        tab_right: tab_right {
            label = "TAB_RIGHT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>; tap-ms = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp TAB>, <&macro_release &kp LCTRL>;
        };
        tab_left: tab_left {
            label = "TAB_LEFT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>; tap-ms = <0>;
            bindings = <&macro_press &kp LCTRL &kp LSHFT>, <&macro_tap &kp TAB>, <&macro_release &kp LCTRL &kp LSHFT>;
