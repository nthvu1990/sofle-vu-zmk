        };
        // Git: stage (VSCode Ctrl+Shift+G then A — approximation via palette)
        // Kept simple: Ctrl+Shift+P → quick access
        cmd_pal: cmd_pal {
            label = "COMMAND_PALETTE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>; wait-ms = <0>;
            bindings = <&macro_press &kp LCTRL &kp LSHFT>, <&macro_tap &kp P>, <&macro_release &kp LCTRL &kp LSHFT>;
        };

// ── Unicode Special Characters ────────────────────────────────────
// Need regkey HKEY_CURRENT_USER\Control Panel\Input Method, REG_SZ EnableHexNumpad = 1
